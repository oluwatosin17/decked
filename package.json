{
  "name": "decked",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-pages.mjs",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:bundle": "node scripts/audit-browser-secrets.mjs",
    "verify:analytics": "vitest run src/analytics/reconciliation.test.ts",
    "profile:analytics": "vitest run src/analytics/performance.test.ts --reporter=verbose",
    "audit:prompts": "node scripts/audit-prompts.mjs",
    "audit:content": "node scripts/audit-content-inventory.mjs",
    "content:seed": "node scripts/generate-content-seed.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mingcute/react": "^3.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.1",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
