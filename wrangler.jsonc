{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "decked",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-10-10",
  "previews": {},
  "routes": [
    { "pattern": "www.usedecked.com", "custom_domain": true },
    { "pattern": "usedecked.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/icons/*",
      "!/brand/*",
      "!/favicon*",
      "!/pwa-*",
      "!/apple-touch-icon-*",
      "!/manifest.webmanifest",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/workbox-*"
    ]
  }
}
